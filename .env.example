# Application
HOST=0.0.0.0
PORT=8000
APP_NAME=FastAPI Base
# Deployment environment: development | staging | production.
# When set to "production", the app refuses to boot with default dev secrets
# (e.g. DB_PASSWORD=postgres). Defaults to "development" when unset.
ENVIRONMENT=development

# Database (PostgreSQL via asyncpg)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=fastapi_base

# Auth — JWT (RS256)
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
AUTH_JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
AUTH_JWT_ISSUER=fastapi-base
AUTH_JWT_AUDIENCE=fastapi-base
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_CHALLENGE_TOKEN_EXPIRE_MINUTES=5
AUTH_OAUTH_STATE_EXPIRE_MINUTES=5

# Auth — OTP (email verification)
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRE_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5

# Auth — TOTP (2FA)
AUTH_TOTP_ISSUER=FastAPI Base

# Auth — Google OAuth2
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Email — SMTP delivery (defaults point at the MailHog container in compose.yml)
EMAIL_SENDER_ADDRESS=no-reply@fastapi-base.local
EMAIL_SENDER_NAME=FastAPI Base
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USE_TLS=false
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TIMEOUT_SECONDS=5
EMAIL_TEMPLATE_DIR=apps/core/email/templates
