# Application
HOST=0.0.0.0
PORT=8000
APP_NAME=FastAPI Base
# Deployment environment: development | staging | production.
# When set to "production", the app refuses to boot with default dev secrets
# (e.g. DB_PASSWORD=postgres). Defaults to "development" when unset.
ENVIRONMENT=development

# Database (PostgreSQL via asyncpg)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=fastapi_base

# Auth — JWT (RS256)
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
AUTH_JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
AUTH_JWT_ISSUER=fastapi-base
AUTH_JWT_AUDIENCE=fastapi-base
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_CHALLENGE_TOKEN_EXPIRE_MINUTES=5
AUTH_OAUTH_STATE_EXPIRE_MINUTES=5

# Auth — OTP (email verification)
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRE_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5

# Rate limiting (slowapi).
# ``memory://`` is per-worker; switch to ``redis://host:port/db`` to share
# the limit window across all uvicorn workers.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_ENABLED=true

# RBAC — Casbin Redis watcher.
# Required whenever WORKERS > 1: each worker has its own in-memory enforcer
# and the watcher broadcasts policy mutations via Redis pub/sub. Leave empty
# for single-worker dev.
RBAC_WATCHER_REDIS_URL=

# RBAC — auto-seed Permission rows and Casbin admin policies from
# @rbac_resource-decorated ORM models at startup. Idempotent. Disabled by
# default; flip to true once you have a stable admin-role convention.
RBAC_AUTO_SEED_RESOURCES_FROM_REGISTRY=false
RBAC_SYSTEM_ADMIN_ROLE_NAME=system_admin

# Auth — TOTP (2FA)
AUTH_TOTP_ISSUER=FastAPI Base
# Generate a fresh key with: `uv run python scripts/generate_totp_key.py`
# REQUIRED in production; leave empty in dev for an auto-derived per-process key.
AUTH_TOTP_ENCRYPTION_KEY=

# Auth — Google OAuth2
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Redis — generic cache / distributed-state backend.
# REDIS_ENABLED=false short-circuits the cache layer entirely (dev / tests).
# Flip to true and point HOST/PORT at a reachable Redis to enable caching.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_DECODE_RESPONSES=true

# Storage — S3 (LocalStack for dev, real AWS S3 in production).
# Defaults match the LocalStack container declared in compose.yml.
STORAGE_S3_ENDPOINT_URL=http://localhost:4566
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=fastapi-base-blog
STORAGE_S3_ACCESS_KEY_ID=test
STORAGE_S3_SECRET_ACCESS_KEY=test
STORAGE_PRESIGN_EXPIRES_SECONDS=900
STORAGE_MAX_UPLOAD_BYTES=10485760
# Path-style addressing — required for LocalStack; flip false for real AWS S3.
STORAGE_USE_PATH_STYLE=true

# Observability — OpenTelemetry traces / logs / metrics.
# OBSERVABILITY_ENABLED=false short-circuits the entire OTel stack (dev / tests).
# Flip to true and point OBSERVABILITY_OTLP_ENDPOINT at a collector (e.g.
# http://otel-collector:4317) to export all three signals. When enabled
# without an endpoint, the tracer provider is still installed so log lines
# carry trace_id/span_id even without an exporter.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_SERVICE_NAME=fastapi-base
OBSERVABILITY_OTLP_ENDPOINT=
# Per-signal endpoint overrides — leave empty to fall back to OBSERVABILITY_OTLP_ENDPOINT.
OBSERVABILITY_OTLP_LOGS_ENDPOINT=
OBSERVABILITY_OTLP_METRICS_ENDPOINT=
# Disable individual exporters even when observability is enabled. Useful when
# only some signals are wanted (e.g. traces only during early bring-up).
OBSERVABILITY_LOGS_EXPORT_ENABLED=true
OBSERVABILITY_METRICS_EXPORT_ENABLED=true
OBSERVABILITY_METRIC_EXPORT_INTERVAL_MILLIS=30000
# Opt into stable HTTP semantic conventions. Setting this to ``http`` makes the
# FastAPI instrumentor emit ``http.server.request.duration`` (seconds) with the
# new label set — matching the provisioned Grafana dashboard. Leave unset to
# keep the legacy ``http.server.duration`` (ms) metric.
OTEL_SEMCONV_STABILITY_OPT_IN=

# Email — SMTP delivery (defaults point at the MailHog container in compose.yml)
EMAIL_SENDER_ADDRESS=no-reply@fastapi-base.local
EMAIL_SENDER_NAME=FastAPI Base
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USE_TLS=false
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TIMEOUT_SECONDS=5
EMAIL_TEMPLATE_DIR=apps/core/email/templates

# Blog — Post-version history retention tunables (see apps/settings.py:BlogSettings).
# All have safe defaults; uncomment only when you need to override.
# BLOG_POST_VERSION_RETENTION_LIMIT=20
# BLOG_POST_VERSION_COMPRESSION_LEVEL=3
# BLOG_POST_VERSION_SWEEP_INTERVAL=600.0
